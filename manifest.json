{
  "id": "ibkr-multi-import",
  "name": "IBKR Multi-Currency Import",
  "version": "1.1.0",
  "description": "Import IBKR transactions via CSV files or Flex Query API with automatic multi-currency account creation",
  "author": "Nikolai Trukhin",
  "sdkVersion": "3.12.0",
  "minWealthfolioVersion": "3.12.0",
  "main": "dist/addon.js",
  "enabled": true,
  "permissions": [
    {
      "category": "accounts",
      "functions": [
        {
          "name": "getAll",
          "isDeclared": true,
          "isDetected": false,
          "detectedAt": null
        },
        {
          "name": "create",
          "isDeclared": true,
          "isDetected": false,
          "detectedAt": null
        }
      ],
      "purpose": "Create and manage multi-currency accounts"
    },
    {
      "category": "activities",
      "functions": [
        {
          "name": "getAll",
          "isDeclared": true,
          "isDetected": false,
          "detectedAt": null
        },
        {
          "name": "import",
          "isDeclared": true,
          "isDetected": false,
          "detectedAt": null
        }
      ],
      "purpose": "Import transactions from IBKR CSV files or Flex Query API and skip duplicates of existing activities"
    },
    {
      "category": "market-data",
      "functions": [
        {
          "name": "searchTicker",
          "isDeclared": true,
          "isDetected": false,
          "detectedAt": null
        }
      ],
      "purpose": "Resolve ticker symbols from ISINs"
    },
    {
      "category": "secrets",
      "functions": [
        {
          "name": "get",
          "isDeclared": true,
          "isDetected": false,
          "detectedAt": null
        },
        {
          "name": "set",
          "isDeclared": true,
          "isDetected": false,
          "detectedAt": null
        },
        {
          "name": "delete",
          "isDeclared": true,
          "isDetected": false,
          "detectedAt": null
        }
      ],
      "purpose": "Securely store IBKR Flex Query credentials in system keyring"
    },
    {
      "category": "events",
      "functions": [
        {
          "name": "onUpdateComplete",
          "isDeclared": true,
          "isDetected": false,
          "detectedAt": null
        }
      ],
      "purpose": "Trigger automatic Flex Query fetch on portfolio updates"
    },
    {
      "category": "network",
      "functions": [
        {
          "name": "request",
          "isDeclared": true,
          "isDetected": false,
          "detectedAt": null
        }
      ],
      "purpose": "Fetch Flex Query statements from IBKR and resolve tickers via Yahoo Finance"
    }
  ],
  "network": {
    "allowedHosts": [
      "ndcdyn.interactivebrokers.com",
      "query1.finance.yahoo.com"
    ]
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.12.0",
    "@wealthfolio/ui": "^3.12.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "homepage": "https://github.com/CoolONEOfficial/wealthfolio-ibkr-addon",
  "repository": "https://github.com/CoolONEOfficial/wealthfolio-ibkr-addon",
  "bugs": "https://github.com/CoolONEOfficial/wealthfolio-ibkr-addon/issues",
  "license": "MIT",
  "keywords": [
    "ibkr",
    "interactive-brokers",
    "import",
    "multi-currency",
    "flex-query"
  ],
  "icon": null
}
